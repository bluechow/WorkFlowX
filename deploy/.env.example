# ============================================================
# WorkFlowX 部署环境变量模板（P16-15）
# 复制为 deploy/.env 并填入真实值；.env 已被 .gitignore 忽略
# 禁止将真实 secret 提交进 Git（Phase 15 secrets scan 会拦截）
# ============================================================

# ---------- Spring Profile ----------
# dev  = 含 Flyway dev seed（自动创建 admin/user1 演示账号，见下）
# prod = 不含 seed（首次需自行引导管理员账号）
SPRING_PROFILES_ACTIVE=dev

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password
MYSQL_DATABASE=workflowx
# 应用账号（后端连接用；root 仅容器内初始化）
MYSQL_APP_USER=workflowx
MYSQL_APP_PASSWORD=CHANGE_ME_app_password

# ---------- Redis ----------
# 无需额外配置（AOF 持久化已启用；session 行为见 security-testing.md）

# ---------- MinIO ----------
MINIO_ROOT_USER=CHANGE_ME_minio_user
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password_16
MINIO_BUCKET=workflowx

# ---------- JWT ----------
# dev profile 有本地默认密钥（仅本地环境）；生产/对外部署必须显式提供 ≥32 字节强随机密钥
# 生成示例: openssl rand -base64 48
JWT_SECRET=

# ---------- 对外端口 ----------
# 前端（Nginx）对外端口；backend/mysql/redis/minio 均不对外暴露
FRONTEND_PORT=80

# ---------- 演示账号（仅 SPRING_PROFILES_ACTIVE=dev 时自动创建） ----------
# admin    / Admin@123456   （ADMIN 角色）
# user1    / Member@123456  （MEMBER 角色）
# ⚠ 首次登录后建议立即修改密码

# 演示数据开关（true=启动时自动生成演示数据，幂等可常开）
DEMO_SEED=false
