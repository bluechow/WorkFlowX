# WorkFlowX 本地开发环境变量模板
# 复制为 .env 后按需修改（.env 已被 gitignore，禁止提交真实密码）
#   cp .env.example .env

# ===== MySQL =====
# 主机端口默认 3307：本机 3306 被遗留 MySQL80 服务占用（ADR-007）
MYSQL_HOST_PORT=3307
MYSQL_ROOT_PASSWORD=workflowx_dev_root
MYSQL_DATABASE=workflowx

# ===== Redis =====
REDIS_HOST_PORT=6379

# ===== MinIO =====
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=workflowx_dev_minio

# ===== JWT（P2-06）=====
# dev-only 默认密钥；生产环境必须更换为独立强随机密钥（≥32 字节）
JWT_SECRET=dev-only-jwt-secret-key-for-workflowx-local-0123456789
JWT_EXPIRE_HOURS=2

# ===== 通用 =====
TZ=Asia/Shanghai
